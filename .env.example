# Copy to .env and fill in. .env is gitignored.
#
# Postmark *Server* API token for the server that hosts the voicemail stream.
# This single token authorizes the Messages API, Suppressions API, and /email send.
#
# You can provide the raw token directly:
# POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# ...OR provide a 1Password secret reference (resolved at runtime via the `op` CLI,
# never written to disk). Requires the 1Password CLI installed and signed in.
POSTMARK_SERVER_TOKEN=op://Vault/Postmark/server-token

# If you have multiple 1Password accounts, set which one to read the reference
# from. Accepts a sign-in address (e.g. my-account.1password.com), an account
# shorthand, or an account/user UUID. Passed to `op read --account`.
# Run `op account list` to see your accounts.
# OP_ACCOUNT=my-account.1password.com

# Optional: message stream that voicemails are sent on (default: outbound)
# POSTMARK_MESSAGE_STREAM=outbound

# Optional: API base URL (default: https://api.postmarkapp.com)
# POSTMARK_API_BASE=https://api.postmarkapp.com
